# ---- LLM (pick one; leave both empty to run the deterministic offline mock) -------------------
ANTHROPIC_API_KEY=
# LLM_PROVIDER=auto            # auto | anthropic | openai | mock
# LLM_MODEL=claude-opus-5      # primary: supervisor, aggregation, final answer
# LLM_WORKER_MODEL=claude-haiku-4-5   # worker: RLM batch sub-agents, reranking
OPENAI_API_KEY=

# ---- Embeddings (auto: voyage > openai > local hashed fallback) ----------------------------------
VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=auto      # auto | voyage | openai | local

# ---- Vector DB ------------------------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=meridian-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Observability ---------------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meridian-knowledge-assistant
LANGSMITH_TRACING=true

# ---- Security / limits ---------------------------------------------------------------------------------
JWT_SECRET=change-me
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=0.25
TOOL_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=60

# ---- MCP (empty = in-process server; docker compose sets http://mcp:8100/mcp) -------------------------
MCP_SERVER_URL=

# ---- UI --------------------------------------------------------------------------------------------------
API_URL=http://localhost:8000
